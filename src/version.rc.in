#include <winver.h>
1 VERSIONINFO
FILEVERSION @OSU_FIXED_VERSION@
PRODUCTVERSION @OSU_FIXED_VERSION@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Sonic853\0"
      VALUE "FileDescription", "TTPlayer OSZ archive and beat visual add-in\0"
      VALUE "FileVersion", "@OSU_BUILD_VERSION@\0"
      VALUE "InternalName", "ttp_osu\0"
      VALUE "OriginalFilename", "ttp_osu.dll\0"
      VALUE "ProductName", "TTPlayer Rebuild OSU\0"
      VALUE "ProductVersion", "@OSU_BUILD_VERSION@\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
